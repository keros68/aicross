{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aicross",
  "version": "0.0.0",
  "identifier": "com.aicross.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix src-ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix src-ui run build",
    "frontendDist": "../src-ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
