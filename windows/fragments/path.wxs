<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="AicrossConsolePath" Guid="*" Win64="$(var.Win64)">
        <Environment
          Id="AicrossConsolePathEntry"
          Name="PATH"
          Value="[INSTALLDIR]"
          Action="set"
          Part="last"
          Permanent="no"
          System="no"
        />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
