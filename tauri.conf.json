{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aicross",
  "version": "0.3.2",
  "identifier": "com.aicross.desktop",
  "build": {
    "frontendDist": "./src-ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "./src-ui"
    },
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "./src-ui"
    }
  },
  "app": {
    "windows": [
      {
        "title": "aicross",
        "label": "main",
        "width": 960,
        "height": 640,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "zoomHotkeysEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "dmg",
      "app",
      "msi",
      "nsis"
    ],
    "publisher": "aicross",
    "resources": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "wix": {
        "fragmentPaths": [
          "./windows/fragments/path.wxs"
        ],
        "componentRefs": [
          "AicrossConsolePath"
        ],
        "language": "zh-CN"
      },
      "nsis": {
        "installerHooks": "./windows/nsis-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "SimpChinese"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzNzY4RkU3MDQxNkU1MzQKUldRMDVSWUU1NDkyVThabUpEYTNHWTV3NnFGMkhPbDNWVzFobERZb21rTitWUzdsSDBjQ1BjSC8K",
      "endpoints": [
        "https://github.com/keros68/aicross/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
