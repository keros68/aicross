<?xml version="1.0" encoding="utf-8"?>
<!--
  把安装目录作为独立一项加进当前用户的 PATH，卸载时只删这一项。

  两处不能改（09-16 实测，改了 light.exe 直接报错）：
  - Guid 必须写死，不能用 `*`。这个组件只有 Environment 子元素、没有文件，
    KeyPath 会退化成 Directory，而用目录当 KeyPath 的组件不允许自动 GUID
    （LGHT0230）。GUID 一旦发布就不能再改，否则升级时 PATH 项会重复。
  - 因此要显式给一个 KeyPath。用 HKCU 下的一个标记值：System="no" 写的是
    当前用户的 PATH，KeyPath 也就该落在 HKCU，两者的安装范围一致。
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="AicrossConsolePath" Guid="E00E0AE1-C9E9-4582-9546-1D4B3B7B3714" Win64="yes">
        <RegistryValue
          Root="HKCU"
          Key="Software\aicross"
          Name="ConsolePathEntry"
          Type="integer"
          Value="1"
          KeyPath="yes"
        />
        <Environment
          Id="AicrossConsolePathEntry"
          Name="PATH"
          Value="[INSTALLDIR]"
          Action="set"
          Part="last"
          Permanent="no"
          System="no"
        />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
